{
  "info": {
    "_postman_id": "a6ca32da-3ebb-4033-87a0-621f05af9a25",
    "name": "Acortador de URLs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "43359596"
  },
  "variable": [
    {
      "key": "api_base_url",
      "value": "https://fqltkzf336.execute-api.us-east-1.amazonaws.com",
      "type": "string"
    },
    {
      "key": "codigo_valido",
      "value": "Ab3xY9",
      "type": "string"
    },
    {
      "key": "codigo_inexistente",
      "value": "NoExiste123",
      "type": "string"
    },
    {
      "key": "codigo_sin_visitas",
      "value": "SinVisitas123",
      "type": "string"
    },
    {
      "key": "stats_from",
      "value": "2026-05-01",
      "type": "string"
    },
    {
      "key": "stats_to",
      "value": "2026-05-16",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "LP URL Shortener",
      "item": [
        {
          "name": "Shorten URL",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"url\": \"https://youtu.be/xFrGuyw1V8s?si=Biwdg-LYqohj05Px\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{api_base_url}}/shorten",
              "host": [
                "{{api_base_url}}"
              ],
              "path": [
                "shorten"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "LP URL Redirect",
      "item": [
        {
          "name": "Redirect URL - Codigo Valido",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status code is 302\", function () {",
                  "  pm.response.to.have.status(302);",
                  "});",
                  "",
                  "pm.test(\"Location header exists\", function () {",
                  "  pm.expect(pm.response.headers.get(\"Location\")).to.be.a(\"string\").and.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_base_url}}/{{codigo_valido}}",
              "host": [
                "{{api_base_url}}"
              ],
              "path": [
                "{{codigo_valido}}"
              ]
            },
            "description": "Debe retornar 302 con header Location. Desactiva Follow redirects en Postman para ver el 302."
          },
          "response": [],
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        },
        {
          "name": "Redirect URL - Codigo Inexistente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status code is 404\", function () {",
                  "  pm.response.to.have.status(404);",
                  "});",
                  "",
                  "pm.test(\"returns structured error\", function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property(\"error\", \"URL not found\");",
                  "  pm.expect(body).to.have.property(\"code\", pm.collectionVariables.get(\"codigo_inexistente\"));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_base_url}}/{{codigo_inexistente}}",
              "host": [
                "{{api_base_url}}"
              ],
              "path": [
                "{{codigo_inexistente}}"
              ]
            },
            "description": "Debe retornar 404 con JSON estructurado."
          },
          "response": []
        }
      ]
    },
    {
      "name": "LP URL Stats",
      "item": [
        {
          "name": "Stats - Rango Valido",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status code is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"returns stats response\", function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property(\"codigo\", pm.collectionVariables.get(\"codigo_valido\"));",
                  "  pm.expect(body).to.have.property(\"total_clicks\").that.is.a(\"number\");",
                  "  pm.expect(body).to.have.property(\"daily\").that.is.an(\"array\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_base_url}}/stats/{{codigo_valido}}?from={{stats_from}}&to={{stats_to}}",
              "host": [
                "{{api_base_url}}"
              ],
              "path": [
                "stats",
                "{{codigo_valido}}"
              ],
              "query": [
                {
                  "key": "from",
                  "value": "{{stats_from}}"
                },
                {
                  "key": "to",
                  "value": "{{stats_to}}"
                }
              ]
            },
            "description": "Consulta estadisticas diarias usando un rango explicito YYYY-MM-DD."
          },
          "response": []
        },
        {
          "name": "Stats - Ultimos 30 Dias",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status code is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"returns default range stats response\", function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property(\"codigo\", pm.collectionVariables.get(\"codigo_valido\"));",
                  "  pm.expect(body).to.have.property(\"total_clicks\").that.is.a(\"number\");",
                  "  pm.expect(body.daily).to.be.an(\"array\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_base_url}}/stats/{{codigo_valido}}",
              "host": [
                "{{api_base_url}}"
              ],
              "path": [
                "stats",
                "{{codigo_valido}}"
              ]
            },
            "description": "No envia from/to para probar el default de ultimos 30 dias."
          },
          "response": []
        },
        {
          "name": "Stats - Codigo Sin Visitas",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status code is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"returns empty daily array\", function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property(\"codigo\", pm.collectionVariables.get(\"codigo_sin_visitas\"));",
                  "  pm.expect(body).to.have.property(\"total_clicks\", 0);",
                  "  pm.expect(body).to.have.property(\"daily\").that.eql([]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_base_url}}/stats/{{codigo_sin_visitas}}?from={{stats_from}}&to={{stats_to}}",
              "host": [
                "{{api_base_url}}"
              ],
              "path": [
                "stats",
                "{{codigo_sin_visitas}}"
              ],
              "query": [
                {
                  "key": "from",
                  "value": "{{stats_from}}"
                },
                {
                  "key": "to",
                  "value": "{{stats_to}}"
                }
              ]
            },
            "description": "Debe retornar 200 con total_clicks 0 y daily como array vacio."
          },
          "response": []
        }
      ]
    }
  ]
}
